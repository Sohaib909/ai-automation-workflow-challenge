# Copy to .env.local. Everything is optional: with no AI key the app uses a clearly labelled MOCK provider.

# --- AI provider (first configured wins: Ollama → Gemini → OpenRouter; or force one with AI_PROVIDER=ollama|gemini|openrouter|mock)
# AI_PROVIDER=

# Ollama Cloud (default provider). Create a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=
# Cloud model name as listed by `curl https://ollama.com/api/tags` (e.g. gpt-oss:120b, gemma4:31b, kimi-k2.6, deepseek-v4.1-flash)
OLLAMA_MODEL=gpt-oss:120b
# Leave unset for cloud (https://ollama.com). Set http://localhost:11434 and clear OLLAMA_API_KEY to use a local daemon instead.
# OLLAMA_BASE_URL=

# Google AI Studio free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# OpenRouter (has free models; IDs change, verify at https://openrouter.ai/models?q=free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- App
# --- Storage
# REQUIRED on Vercel (serverless functions don't share a disk): a free Turso database.
# Vercel → your project → Storage / Marketplace → Turso, or create one at turso.tech and copy:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Without Turso (local development) data is stored in a JSON file: ./data/cerealbox.json
# Delete the file to start empty again.
# STORE_FILE=./data/cerealbox.json
# Name recorded on approvals/audit until real auth is added
DEMO_REVIEWER_NAME=Demo Reviewer

# --- Image generation (Static Creative ads)
# Default: Pollinations (free, no key; 1 image per 45s; small watermark).
# For clean FLUX images with no watermark, add a free Hugging Face token (https://huggingface.co/settings/tokens):
HF_TOKEN=
# Optional Pollinations token (higher limits): POLLINATIONS_TOKEN=
# Turn images off entirely: IMAGE_PROVIDER=none
